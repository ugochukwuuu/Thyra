# Local settings for the API (supabase/functions/api). Never commit this file.
# In production the same names are set with `npx supabase secrets set` (see README).

# --- Supabase: Project Settings > API. Supabase sets these itself for the deployed function.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

CLIENT_URL=http://localhost:5173
JOBS_SECRET=a-long-random-string

EMAIL_USE_RESEND=true
RESEND_API_KEY=
SENDBYTE_API_KEY=
EMAIL_FROM=Thyra <no-reply@mail.thyratechnology.com>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

LEAD_FORM_ORIGINS=https://thyratechnology.com,https://www.thyratechnology.com

# --- Only used locally
# `npm test`: a local PostgreSQL database the tests wipe.
TEST_DATABASE_URL=postgres://postgres@localhost:5432/thyra_test
# `npm run seed:admin`: the first admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
