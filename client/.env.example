# From Supabase: Project Settings > API. The anon (public) key is safe to ship in the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=
# Optional: where the API runs, when not the deployed Edge Function, e.g. `npm run api` locally:
# VITE_API_URL=http://localhost:8000/api
