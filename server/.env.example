# --- Core ---
NODE_ENV=development
PORT=4000
# Where the React app is served from. Used for CORS and for links in emails.
CLIENT_URL=http://localhost:5173

# --- Database ---
DATABASE_URL=postgres://postgres@localhost:5432/thyra_dev
# Set to "true" when connecting to a database that requires TLS (e.g. Railway's public proxy URL).
DATABASE_SSL=false
# Used by `npm test` only. Tests wipe the tables in this database.
TEST_DATABASE_URL=postgres://postgres@localhost:5432/thyra_test

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_DAYS=7

# --- Email (Resend) ---
# Without a key, reset links are printed to the server console instead (development only).
RESEND_API_KEY=
EMAIL_FROM=Thyra <no-reply@thyra.co>

# --- Cloudinary (product images) ---
# Without these, image uploads return 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Admin seed (npm run seed:admin) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Public lead form ---
# Other sites allowed to post to /api/leads, comma separated (e.g. the WordPress landing page).
LEAD_FORM_ORIGINS=https://thyratechnology.com,https://www.thyratechnology.com
